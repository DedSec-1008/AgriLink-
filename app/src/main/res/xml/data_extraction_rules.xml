<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude credentials, tokens, and databases from cloud backups -->
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
        <exclude domain="sharedpref" path="secure_credentials.xml"/>
        <exclude domain="database" path="secure_data.db"/>
        <exclude domain="root" path="credentials"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude credentials and unencrypted keys from device transfer -->
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
        <exclude domain="sharedpref" path="secure_credentials.xml"/>
        <exclude domain="database" path="secure_data.db"/>
        <exclude domain="root" path="credentials"/>
    </device-transfer>
</data-extraction-rules>
